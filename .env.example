# ==============================================================================
# KHAGAN LIVE BAKERY MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# 1. Supabase PostgreSQL & Authentication (Public Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Server-Only Secret Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application Locale & Currency Settings
NEXT_PUBLIC_DEFAULT_LOCALE=bn
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dhaka

# 4. Google Spreadsheet Live Synchronization (Server-side Only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
